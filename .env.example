# ─── AI demo (optional) ────────────────────────────────────────────────
# When missing, invalid or out of credit, the demos answer from the built-in
# engine in src/lib/demo-engine.ts and still look live to visitors.
ANTHROPIC_API_KEY=
# Model used for the live demos (default: claude-haiku-5-5)
ANTHROPIC_MODEL=claude-haiku-5-5

# ─── Lead delivery for the contact form (set at least one) ─────────────
# Resend (https://resend.com) – free tier is enough. CONTACT_TO_EMAIL can be
# a comma-separated list. CONTACT_FROM_EMAIL needs a verified domain in Resend.
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@3ai.co.il
CONTACT_FROM_EMAIL=3AI Leads <leads@3ai.co.il>
# Any webhook (Make / Zapier / n8n / Google Sheets) that accepts a JSON POST
LEADS_WEBHOOK_URL=

# ─── Analytics / SEO (optional) ────────────────────────────────────────
# Google Ads / GA4 tag id (default AW-18158835511)
NEXT_PUBLIC_GTAG_ID=
# Google Ads conversion label, e.g. AW-18158835511/AbCdEfGhIj
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION=
# Google Search Console HTML-tag verification code
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
